{
  "name": "openvibe-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.Wiki: wiki spaces with page trees, immutable revisions, diff and revert, citations, infoboxes, internal links, Media attachments and Community discussion, server-rendered and useful without JavaScript.",
