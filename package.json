  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "seed": "node scripts/seed.js",
    "test": "node test/run.js"
  },
  "keywords": ["openvibe", "wiki", "publishing"],
