{
  "name": "openvibe-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "OpenVibe.Wiki: wiki spaces with page trees, immutable revisions, diff and revert, citations, infoboxes, internal links, Media attachments and Community discussion, server-rendered and useful without JavaScript.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "seed": "node scripts/seed.js",
    "test": "node test/run.js",
    "test:pg": "WIKI_TEST_STORE=pg node test/run.js"
  },
  "keywords": [
    "openvibe",
    "wiki",
    "publishing"
  ],
  "author": "OpenVibers",
  "license": "AGPL-3.0-only",
  "repository": "github:OpenVibers/OpenVibe.Wiki",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "iovalkey": "^0.4.0",
    "openvibe-contracts": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.contracts/archive/v0.449.0.tar.gz",
    "openvibe-publishing": "https://codeload.github.com/OpenVibers/OpenVibe.Publishing/tar.gz/refs/tags/v1.7.0",
    "openvibe-sdk": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.sdk/archive/v0.188.0.tar.gz",
    "openvibe-shared": "https://git.openvibe.codes/api/v1/repos/openvibers/openvibe.shared/archive/v4.320.0.tar.gz",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
